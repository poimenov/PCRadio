@page "/search"

@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using PCRadio.DataAccess.Interfaces
@using _models = PCRadio.DataAccess.Models
@using PCRadio.Extensions
@using _regular = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using PCRadio.Services.Interfaces
@inject IStringLocalizer<Search> localizer
@inject IStations stations
@inject IOptions<AppSettings> options
@inject IGenres genres
@inject ICountries countries
@inject IAppStateService appStateService

<div class="search-toolbar">
    <div class="search-toolbar-field">
        <FluentTextInput Label="@localizer["SearchLabel"]" @bind-Value="@SearchName" Class="search-filter"
                         Placeholder="@localizer["SearchPlaceholder"]" />
    </div>

    <div class="search-toolbar-field">
        <FluentSelect TOption="_models.Genre" TValue="_models.Genre" Label="@localizer["Genres"]"
                      OptionValue="@(x => x)" OptionText="@(x => x.Name)" Items="@Genres" Class="search-filter"
                      @bind-Value="@SearchGenre">
            <OptionTemplate>
                <span slot="checked-indicator" style="display: none"></span>
                @context?.Name
            </OptionTemplate>
        </FluentSelect>
    </div>

    <div class="search-toolbar-field">
        <div class="dropdown-with-icon country-dropdown">
            <span class="selected-country-icon">
                @if (SearchCountry != null)
                {
                    @SearchCountry.GetCountryIcon(false)
                }
            </span>
            <FluentSelect TOption="_models.Country" TValue="_models.Country" Label="@localizer["Countries"]"
                          OptionValue="@(x => x)" OptionText="@(x => x.Name)" Items="@Countries" Class="search-filter"
                          ControlStyle="padding-inline-start: 30px;" @bind-Value="@SearchCountry">
                <OptionTemplate>
                    <span slot="checked-indicator" style="display: none"></span>
                    <span class="dropdown-option-content">
                        @context?.GetCountryIcon(false)
                        @context?.Name
                    </span>
                </OptionTemplate>
            </FluentSelect>
        </div>
    </div>
    <div class="search-toolbar-button">
        <FluentButton OnClick="PerformSearch" Title="@localizer["SearchButton"]" AriaLabel="@localizer["SearchButton"]"
                      IconOnly="true" Disabled="@(!_searchEnabled)">
            <FluentIcon Value="@(new _regular.Size20.Search())" Color="Color.Primary" />
        </FluentButton>
    </div>
</div>

<PCRadio.Components.Controls.StationsList Count="@_result?.TotalCount" PageSize="@PageSize"
                                          Stations="@_result?.Stations.ToList()" GetStations="@((skip, take) => stations.SearchAsync(_params, skip, take))" />


@code
{
    private int PageSize => options.Value.PageSize;
    private string? SearchName { get; set; }
    private List<_models.Country>? _countries = null;
    private List<_models.Country> Countries
    {
        get
        {
            if (_countries is null)
            {
                _countries = countries.GetAll().ToList();
                _countries.Insert(0, new _models.Country { Id = 0, Name = string.Empty });
            }

            return _countries;
        }
    }
    private List<_models.Genre>? _genres = null;
    private List<_models.Genre> Genres
    {
        get
        {
            if (_genres is null)
            {
                _genres = genres.GetAll().ToList();
                _genres.Insert(0, new _models.Genre { Id = 0, Name = string.Empty });
            }

            return _genres;
        }
    }
    private _models.Country? SearchCountry { get; set; }
    private _models.Genre? SearchGenre { get; set; }
    private StationsResult? _result = default!;
    private SearchParams? _params = default!;
    private bool _searchEnabled { get; set; } = true;

    protected override void OnInitialized()
    {
        SearchCountry = Countries.First();
        SearchGenre = Genres.First();
        appStateService.Title = localizer["Header"];
    }

    private async Task PerformSearch()
    {
        _searchEnabled = false;
        _params = new SearchParams { Name = SearchName, CountryId = SearchCountry?.Id ?? 0, GenreId = SearchGenre?.Id ?? 0 };
        _result = await stations.SearchAsync(_params, 0, PageSize);
        var title = _result.TotalCount > 0 ? $"{localizer["Header"]} ({_result.TotalCount})" : localizer["Header"];
        appStateService.Title = title;
        _searchEnabled = true;
    }
}