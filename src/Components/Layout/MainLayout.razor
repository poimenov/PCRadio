@using IconsRegular24 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24
@using IconsRegular20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using PCRadio.DataAccess.Interfaces
@using PCRadio.DataAccess.Models
@using PCRadio.Extensions
@using PCRadio.Services.Interfaces
@inherits LayoutComponentBase
@implements IDisposable
@inject ILinkOpeningService linkOpeningService
@inject IStringLocalizer<MainLayout> localizer
@inject IAppStateService appStateService
@inject IOptions<AppSettings> options
@inject IOpenDialogService openDialogService
@inject NavigationManager navigationManager
@inject IStations stations
@inject IStationTopicsService stationTopics
@inject IJSRuntime JSRuntime
<div class="application-layout">
    <header class="application-header">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Left"
                     VerticalAlignment="VerticalAlignment.Center">
            <img src="favicon.ico" style="height: 50px;" />
            <FluentLink Href="#" Appearance="LinkAppearance.Default" Class="appName"
                        title="@($"{AppSettings.APPLICATION_NAME} v{typeof(AppSettings).Assembly.GetName().Version}")"
                        OnClick="@(()=>OpenLink("https://pcradio.app"))">
                @AppSettings.APPLICATION_NAME
            </FluentLink>
        </FluentStack>
    </header>
    <div class="main" style="width: 100%;">
        <NavMenu />
        <main class="body-content">
            <div class="content">
                <div class="page-layout">
                    <div class="localized-content" @key="cultureName">
                        <FluentStack Class="page-heading" Orientation="Orientation.Horizontal"
                                     HorizontalAlignment="HorizontalAlignment.Left" Spacing="Spacing.Large"
                                     VerticalAlignment="VerticalAlignment.Center">
                            <FluentIcon Value="@TitleIcon" Color="Color.Primary" />
                            <FluentLabel Typo="Typography.H2" Style="font-size: 24px; line-height: 1.3;">@Title
                            </FluentLabel>
                            @if (IsExportVisible)
                            {
                                <FluentSpacer />
                                <FluentButton
                                    IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.ArrowDownload())"
                                    Size="ButtonSize.Small" title="@localizer["ExportTitle"]" OnClick="@ExportStationsAsync"
                                    Loading="@IsExportProcessing" Style="margin-right: 12px;"
                                    Color="var(--colorBrandForeground1)">
                                    @localizer["Export"]
                                </FluentButton>
                            }
                        </FluentStack>
                        @Body
                    </div>
                    @if (SelectedStationId.HasValue)
                    {
                        <PCRadio.Components.Controls.Player StationId="@SelectedStationId" />
                    }
                </div>
            </div>
        </main>
    </div>
    <footer>
        <FluentStack Orientation="Orientation.Horizontal" Class="status-links">
            <FluentLink Href="#" Appearance="LinkAppearance.Default" title="https://www.tryphotino.io"
                        OnClick="@(()=>OpenLink("https://www.tryphotino.io"))">@localizer["Photino"]
            </FluentLink>
            <FluentLink Href="#" Appearance="LinkAppearance.Default"
                        title="https://learn.microsoft.com/en-us/aspnet/core/blazor"
                        OnClick="@(()=>OpenLink("https://learn.microsoft.com/en-us/aspnet/core/blazor"))">@localizer["Blazor"]
            </FluentLink>
        </FluentStack>
        <FluentSpacer />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right"
                     Class="status-links">
            <FluentLink Href="#" Appearance="LinkAppearance.Default" title="https://www.fluentui-blazor.net"
                        OnClick="@(()=>OpenLink("https://www.fluentui-blazor.net"))">@localizer["FluentUI"]</FluentLink>
            <FluentLink Href="#" Appearance="LinkAppearance.Default" title="https://github.com/poimenov/PCRadio"
                        OnClick="@(()=>OpenLink("https://github.com/poimenov/PCRadio"))">@localizer["SourceCode"]</FluentLink>
        </FluentStack>
    </footer>
</div>

@code
{
    string Title { get; set; } = string.Empty;
    Icon TitleIcon { get; set; } = new IconsRegular24.Home();
    bool IsExportVisible { get; set; } = true;
    bool IsExportProcessing { get; set; } = false;
    int? SelectedStationId { get; set; }
    string cultureName = System.Globalization.CultureInfo.CurrentUICulture.Name;

    protected override void OnInitialized()
    {
        appStateService.TitleChanged += OnTitleChanged;
        appStateService.CurrentStationIdChanged += OnCurrentStationIdChanged;
        appStateService.CultureChanged += OnCultureChanged;
        navigationManager.LocationChanged += OnLocationChanged;
        UpdatePageNavigationState(navigationManager.Uri);
    }

    private void OnCultureChanged(System.Globalization.CultureInfo culture)
    {
        _ = InvokeAsync(() =>
        {
            System.Globalization.CultureInfo.CurrentCulture = culture;
            System.Globalization.CultureInfo.CurrentUICulture = culture;
            cultureName = culture.Name;
            StateHasChanged();
        });
    }

    private void OnTitleChanged(string title)
    {
        _ = InvokeAsync(() =>
        {
            if (Title != title)
            {
                Title = title;
                StateHasChanged();
            }
        });
    }

    private void OnCurrentStationIdChanged(int stationId)
    {
        _ = InvokeAsync(() =>
        {
            if (SelectedStationId != stationId)
            {
                SelectedStationId = stationId;
                StateHasChanged();
            }
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            UpdatePageNavigationState(navigationManager.Uri);
            StateHasChanged();
        });
    }

    private void UpdatePageNavigationState(string uri)
    {
        switch (uri)
        {
            case var currentUri when currentUri.EndsWith("/genres", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.MusicNote2();
                IsExportVisible = false;
                break;
            case var currentUri when currentUri.EndsWith("/topics", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.Collections();
                IsExportVisible = false;
                break;
            case var currentUri when currentUri.Contains("/topic/", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular20.MusicNote2Play();
                IsExportVisible = true;
                break;
            case var currentUri when currentUri.Contains("/genre/", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.MusicNote2();
                IsExportVisible = true;
                break;
            case var currentUri when currentUri.Contains("/subgenre/", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.MusicNote1();
                IsExportVisible = true;
                break;
            case var currentUri when currentUri.EndsWith("favorites", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.Heart();
                IsExportVisible = true;
                break;
            case var currentUri when currentUri.EndsWith("settings", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.Settings();
                IsExportVisible = false;
                break;
            case var currentUri when currentUri.EndsWith("history", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.History();
                IsExportVisible = false;
                break;
            case var currentUri when currentUri.EndsWith("search", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.Search();
                IsExportVisible = false;
                break;
            case var currentUri when currentUri.EndsWith("import", StringComparison.OrdinalIgnoreCase):
                TitleIcon = new IconsRegular24.ArrowImport();
                IsExportVisible = false;
                break;
            default:
                TitleIcon = new IconsRegular24.Home();
                IsExportVisible = true;
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("markAppReady");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void OpenLink(string url)
    {
        linkOpeningService.OpenUrl(url);
    }

    public void Dispose()
    {
        appStateService.TitleChanged -= OnTitleChanged;
        appStateService.CurrentStationIdChanged -= OnCurrentStationIdChanged;
        appStateService.CultureChanged -= OnCultureChanged;
        navigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task ExportStationsAsync()
    {
        var currentUri = navigationManager.Uri;
        var isTopicExport = currentUri.Contains("/topic/", StringComparison.OrdinalIgnoreCase);
        if (!(currentUri.Contains("genre") || isTopicExport
              || currentUri.EndsWith("favorites") || currentUri.EndsWith("/")))
        {
            return;
        }

        var folderPath = openDialogService.OpenFolder(localizer["SelectFolder"],
                                    Environment.GetFolderPath(Environment.SpecialFolder.MyMusic));
        if (folderPath == null || !folderPath.Any() || !Directory.Exists(folderPath.First()))
        {
            return;
        }

        IsExportProcessing = true;

        try
        {
            var topicSlug = isTopicExport ? GetTopicSlugFromUri(currentUri) : string.Empty;
            (IEnumerable<StationInfo>?, string, bool) stationsToExport = currentUri switch
            {
                var uri when uri.Contains("/topic/", StringComparison.OrdinalIgnoreCase) =>
                    (await stationTopics.ExportByTopicAsync(topicSlug), topicSlug, false),
                var uri when uri.Contains("genre") =>
                    (await stations.ExportByGenreAsync(GetIdFromUri(uri)), Title.Replace(" ", "_"), true),
                var uri when uri.EndsWith("favorites") => (await stations.ExportFavoritesAsync(), "favorites", true),
                var uri when uri.EndsWith("/") => (await stations.ExportRecommendedAsync(), "recommended", true),
                _ => (null, string.Empty, true)
            };

            if (stationsToExport.Item1 != null && stationsToExport.Item1.Any())
            {
                var m3uContent = ConvertToM3U(stationsToExport.Item1, stationsToExport.Item3);
                var filePath = Path.Combine(folderPath.First(), $"PCRadio_{stationsToExport.Item2}.m3u");
                await File.WriteAllTextAsync(filePath, m3uContent);
            }
        }
        finally
        {
            IsExportProcessing = false;
        }
    }

    private int GetIdFromUri(string uri)
    {
        var segments = new Uri(uri).Segments;
        if (segments.Length > 2 && int.TryParse(segments[2].TrimEnd('/'), out int id))
        {
            return id;
        }

        return 0;
    }

    private static string GetTopicSlugFromUri(string uri)
    {
        var segments = new Uri(uri).Segments;
        var topicIndex = Array.FindIndex(
            segments,
            segment => string.Equals(segment.Trim('/'), "topic", StringComparison.OrdinalIgnoreCase));

        return topicIndex >= 0 && topicIndex + 1 < segments.Length
            ? Uri.UnescapeDataString(segments[topicIndex + 1].Trim('/'))
            : string.Empty;
    }

    private string ConvertToM3U(IEnumerable<StationInfo> stations, bool appendQuality = true)
    {
        var quality = options?.Value?.GetQuality() ?? "med";
        var sBuilder = new System.Text.StringBuilder();
        sBuilder.AppendLine("#EXTM3U");
        foreach (var station in stations)
        {
            sBuilder.AppendLine($"#EXTINF:-1, tvg-logo=\"{station.LogoUrl}\" group-title=\"{string.Join(";",
station.Genres)}\" radio=\"true\", {station.Name}");
            sBuilder.AppendLine(appendQuality ? $"{station.Url}-{quality}" : station.Url);
        }

        return sBuilder.ToString();
    }
}