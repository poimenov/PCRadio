@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using PCRadio.DataAccess.Interfaces
@using PCRadio.Extensions
@inject IStringLocalizer<StationPanel> localizer
@inject ILogger<StationPanel> logger
@inject IGenres genres
@inject INotificationService notificationService
@inject IStations stations
@inject ICountries countries
@inherits FluentDialogInstance

<style>
    .textBox {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        margin-block-end: -12px;
    }
</style>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0px">
        <FluentTextInput Class="textBox" Label="@localizer["Name"]" @bind-Value="@(Content!.Name)"
                         @bind-Value:after="UpdateSaveActionState" />
        <FluentTextInput Class="textBox" Label="@localizer["Logo"]" @bind-Value="@Content!.Logo" />
        <FluentTextInput Class="textBox" Label="@localizer["Stream"]" @bind-Value="@Content!.Stream"
                         @bind-Value:after="UpdateSaveActionState" />
        <FluentTextArea Class="textBox" Label="@localizer["Description"]" @bind-Value="@Content!.Description"
                        Height="150px" />
        @if (Content != null && Content.CountryId is null)
        {
            <FluentSelect TOption="PCRadio.DataAccess.Models.Country" TValue="PCRadio.DataAccess.Models.Country"
                          Label="@localizer["Country"]" OptionValue="@(x => x)" Items="@Countries" Class="textBox" Height="200px"
                          @bind-Value="@SelectedCountry">
                <OptionTemplate>
                    <FluentStack>
                        @context?.GetCountryIcon(false)
                        @context?.Name
                    </FluentStack>
                </OptionTemplate>
            </FluentSelect>
        }
        @if (Content != null && (Content.StationGenres == null || !Content.StationGenres.Any()))
        {
            <FluentSelect TOption="PCRadio.DataAccess.Models.Genre" TValue="PCRadio.DataAccess.Models.Genre"
                          Label="@localizer["Genre"]" OptionText="@(g => g.Name)" Class="textBox" @bind-Value="@SelectedGenre"
                          OptionValue="@(g => g)" Items="@Genres" Height="200px" />
        }

        <FluentCheckbox Class="textBox" @bind-Value="@(Content!.IsFavorite)">@localizer["IsFavorite"]</FluentCheckbox>

    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter] public PCRadio.DataAccess.Models.Station Content { get; set; } = default!;

    private IEnumerable<PCRadio.DataAccess.Models.Genre>? Genres { get; set; }
    private IEnumerable<PCRadio.DataAccess.Models.Country>? Countries { get; set; }
    private PCRadio.DataAccess.Models.Genre? SelectedGenre { get; set; }
    private PCRadio.DataAccess.Models.Country? SelectedCountry { get; set; }
    private bool IsSaving { get; set; }
    private bool IsValid
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Content.Name))
            {
                return false;
            }

            if (string.IsNullOrWhiteSpace(Content.Stream))
            {
                return false;
            }

            return Uri.TryCreate(Content.Stream, UriKind.Absolute, out Uri? _);
        }
    }

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        footer.PrimaryFirst = true;
        footer.PrimaryAction.Label = Content.Id > 0 ? localizer["Update"] : localizer["Import"];
        footer.PrimaryAction.Disabled = !IsValid;
        footer.SecondaryAction.Label = localizer["Close"];
    }

    protected override void OnInitialized()
    {
        Genres = genres.GetAll();
        Countries = countries.GetAll();
        if (Content.StationGenres == null || !Content.StationGenres.Any())
        {
            SelectedGenre = Genres.FirstOrDefault();
        }
        base.OnInitialized();
    }

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (primary)
        {
            await SaveAsync();
        }
        else
        {
            await CloseDialogAsync();
        }
    }

    private Task CloseDialogAsync() => DialogInstance.CancelAsync();

    private async Task SaveAsync()
    {
        if (IsSaving || !IsValid)
        {
            return;
        }

        IsSaving = true;
        UpdateSaveActionState();
        try
        {
            if (Content.Id > 0)
            {
                await UpdateAsync();
            }
            else
            {
                await ImportAsync();
            }
        }
        finally
        {
            IsSaving = false;
            UpdateSaveActionState();
        }
    }

    private void UpdateSaveActionState()
    {
        DialogInstance.Options.Footer.PrimaryAction.Disabled = IsSaving || !IsValid;
    }

    private async Task ImportAsync()
    {
        if (Content != null && Content.Id == 0)
        {
            if (SelectedGenre is not null && (Content.StationGenres == null || !Content.StationGenres.Any()))
            {
                var stationGenres = new List<DataAccess.Models.StationGenre>();
                stationGenres.Add(new DataAccess.Models.StationGenre()
                {
                    Genre = SelectedGenre,
                    GenreId = SelectedGenre.Id,
                    Station = Content,
                    StationId = Content.Id
                });
                Content.StationGenres = stationGenres;
            }

            if (SelectedCountry is not null && Content.CountryId is null)
            {
                Content.CountryId = SelectedCountry.Id;
            }

            var oResult = await stations.AddStationAsync(Content);
            if (!oResult.Success)
            {
                logger.LogError(oResult.Exception, oResult.Message);
                await notificationService.ShowErrorToastAsync($"{localizer["AddError"]}: {oResult.Message}");
                return;
            }

            if (oResult.Result != null && oResult.Result.Id > 0)
            {
                Content = oResult.Result;
                await notificationService.ShowSuccessToastAsync($"{localizer["Station"]} \"{Content.Name}\" {localizer["Added"]}");
                DialogInstance.Options.Footer.PrimaryAction.Label = localizer["Update"];
                UpdateSaveActionState();
            }
        }
    }
    private async Task UpdateAsync()
    {
        if (Content != null && Content.Id > 0)
        {
            var oResult = await stations.UpdateStationAsync(Content);
            if (oResult.Success)
            {
                await notificationService.ShowSuccessToastAsync($"{localizer["Station"]} \"{Content.Name}\" {localizer["Updated"]}");
            }
            else
            {
                logger.LogError(oResult.Exception, oResult.Message);
                await notificationService.ShowErrorToastAsync($"{localizer["UpdateError"]}: {oResult.Message}");
            }
        }
    }
}