@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using PCRadio.Services.Interfaces;
@inject ISearchService SearchService
@inject IStringLocalizer<SearchListPanel> localizer
@inject IOptions<AppSettings> options
@inject INotificationService notificationService
@inherits FluentDialogInstance

<style>
    .selected-row {
        background-color: var(--colorBrandBackground) !important;
        color: var(--colorNeutralForegroundOnBrand) !important;
        border-left: 4px solid var(--colorBrandBackground);
    }

    .fluent-data-grid-row {
        cursor: pointer;
    }

    .fluent-dialog-body {
        overflow-y: hidden !important;
    }
</style>

<FluentDialogBody>
    <FluentStack HorizontalAlignment="HorizontalAlignment.Stretch" VerticalAlignment="VerticalAlignment.Center"
                 Spacing="Spacing.Medium" HorizontalGap="8" Style="width: 100%; margin-bottom: 15px; flex-shrink: 0;">

        <FluentTextInput @bind-Value="_searchQuery" Placeholder="@localizer["Placeholder"]" @onkeyup="HandleKeyUp"
                         Style="flex-grow: 1;" />

        <FluentButton Appearance="ButtonAppearance.Primary"
                      Disabled="@(isLoading || string.IsNullOrEmpty(_searchQuery))" @onclick="PerformSearch"
                      Style="flex-shrink: 0;">
            @localizer["Search"]
        </FluentButton>

    </FluentStack>


    <div
        style="max-height: calc(100dvh - 195px); overflow-y: auto; overflow-x: hidden; margin-top: 15px; border: 1px solid var(--colorNeutralStroke1);">
        @if (isLoading)
        {
            <div style="padding: 20px; text-align: center;">
                <FluentSpinner />
                <p>@localizer["Loading"]</p>
            </div>
        }
        else
        {
            @if (SearchResults == null || !SearchResults.Any())
            {
                <p style="padding: 10px; text-align: center;">@localizer["NoResultsFound"]</p>
            }
            else
            {
                <FluentDataGrid @ref="_myGrid" Items="@SearchResultsQuery" TGridItem="Track" StripedRows="true" AutoFit="true"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky" RowSize="DataGridRowSize.Smaller" HoveredRows="true"
                                OnRowClick="@HandleRowClick" RowClass="@GetRowClass">

                    <PropertyColumn Property="@(p => p.Artist)" Tooltip="true" TooltipText="@(p => p.Artist)"
                                    Title="@localizer["Artist"]" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Title)" Tooltip="true" TooltipText="@(p => p.Title)"
                                    Title="@localizer["Title"]" Sortable="true" />
                    <PropertyColumn Property="@(p => p.DisplayDuration)" Title="@localizer["Duration"]" Sortable="true" />
                </FluentDataGrid>
            }
        }
    </div>
</FluentDialogBody>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;

    private string _searchQuery = string.Empty;
    private bool isLoading = true;
    private bool isDownloading = false;

    private FluentDataGrid<Track>? _myGrid;
    private IEnumerable<Track> SearchResults = Enumerable.Empty<Track>();
    private IQueryable<Track> SearchResultsQuery = Enumerable.Empty<Track>().AsQueryable();

    private Track? _selectedTrack;
    private string downloadButtonTooltip => $"{localizer["DownloadTooltip"]}: {options.Value.DownloadPath}";

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        footer.PrimaryFirst = true;
        footer.PrimaryAction.Label = localizer["Download"];
        footer.PrimaryAction.Disabled = true;
        footer.SecondaryAction.Label = localizer["Close"];
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _searchQuery = Content;
        await PerformSearch();
    }

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (primary)
        {
            await DownloadSelectedTrackAsync();
        }
        else
        {
            await CloseDialogAsync();
        }
    }

    private async Task PerformSearch()
    {
        isLoading = true;
        _selectedTrack = null;
        StateHasChanged();

        try
        {
            var response = await SearchService.Search(_searchQuery);
            SearchResults = response?.ToList() ?? new List<Track>();
            SearchResultsQuery = SearchResults.AsQueryable();
        }
        catch (Exception)
        {
            SearchResults = Enumerable.Empty<Track>();
            SearchResultsQuery = SearchResults.AsQueryable();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();

            if (_myGrid != null)
            {
                await _myGrid.RefreshDataAsync();
            }
        }
    }

    private void HandleRowClick(FluentDataGridRow<Track> row)
    {
        if (row.Item != null)
        {
            _selectedTrack = row.Item;
            UpdateDownloadActionState();
            StateHasChanged();
        }
    }

    private Task CloseDialogAsync() => DialogInstance.CancelAsync();

    private void UpdateDownloadActionState()
    {
        DialogInstance.Options.Footer.PrimaryAction.Disabled = _selectedTrack is null || isDownloading;
    }

    private string GetRowClass(Track item)
    {
        return _selectedTrack != null && _selectedTrack.Id == item.Id ? "selected-row" : string.Empty;
    }

    private async Task DownloadSelectedTrackAsync()
    {
        if (_selectedTrack == null || isDownloading) return;

        try
        {
            isDownloading = true;
            UpdateDownloadActionState();
            StateHasChanged();

            await SearchService.Download(_selectedTrack);
            await notificationService.ShowSuccessToastAsync($"{localizer["Download"]}: {_selectedTrack.Title} - {localizer["DownloadSuccess"]}");
        }
        catch (Exception ex)
        {
            await notificationService.ShowErrorToastAsync($"{localizer["DownloadError"]}: {ex.Message}");
        }
        finally
        {
            isDownloading = false;
            UpdateDownloadActionState();
            StateHasChanged();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && !string.IsNullOrEmpty(_searchQuery))
        {
            await PerformSearch();
        }
    }

}
