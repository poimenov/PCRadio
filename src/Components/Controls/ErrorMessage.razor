@namespace PCRadio.Components.Controls
@using Microsoft.FluentUI.AspNetCore.Components

<div style="width: 100%">
    <FluentStack HorizontalAlignment="HorizontalAlignment.Left" VerticalAlignment="VerticalAlignment.Center"
                 Orientation="Orientation.Horizontal" HorizontalGap="20">
        <span>@Content.Message</span>
        @if (Content.ActionIcon != null)
        {
            <FluentIcon Value="@(Content.ActionIcon)" Color="Color.Primary" Title="@Content.ActionMessage"
                        Style="cursor: pointer; font-size: 28px; width: 28px; height: 28px; flex: 0 0 28px;"
                        OnClick="@(async () => await Content.ActionCallback!.Value.InvokeAsync(default))" />
        }
    </FluentStack>
</div>

@code {
    [Parameter]
    public ErrorData Content { get; set; } = default!;
}
