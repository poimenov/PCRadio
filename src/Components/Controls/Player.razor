@using Microsoft.Extensions.Logging
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using PCRadio.DataAccess.Interfaces
@using _regular = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using _filled = Microsoft.FluentUI.AspNetCore.Components.Icons.Filled
@using PCRadio.DataAccess.Models
@using PCRadio.Extensions
@using PCRadio.Services.Interfaces
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IOptions<AppSettings> options
@inject IStations stations
@inject ILinkOpeningService linkOpeningService
@inject IStringLocalizer<Player> localizer
@inject IHttpClientFactory httpClientFactory
@inject IHistoryRecords historyRecords
@inject IAppStateService appStateService
@inject INotificationService notificationService
@inject ILogger<Player> logger
@inject IDialogService dialogService
@inject IMetadataService metadataService

<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Class="player">
    <img class="logo" src="@(Station?.Logo ?? AppSettings.DEFAULT_IMG_PATH)" alt="@Station?.Name"
         onerror="this.src='@AppSettings.DEFAULT_IMG_PATH'" title="@Station?.Description" loading="lazy" />
    <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.Top" VerticalGap="4"
                 Class="player-info">
        <div class="player-station-identity">
            @Station?.GetCountryIcon(className: "player-country-flag")
            <FluentButton IconStart="@(Station!.IsFavorite ? new _filled.Size20.Heart() : new _regular.Size20.Heart())"
                          Color="var(--colorBrandForeground1)" OnClick="@ToggleFavorite" Title="@localizer["AddToFavorites"]"
                          Appearance="ButtonAppearance.Transparent" />
            <b class="player-station-name">@Station?.Name</b>
            <span class="player-station-location">(@_country @_cities)</span>
        </div>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="8">
            <FluentButton IconStart="@(new _regular.Size20.EditLineHorizontal3())" Color="var(--colorBrandForeground1)"
                          OnClick="@EditStationInfo" Title="@localizer["EditStationInfo"]"
                          Appearance="ButtonAppearance.Transparent" />
            <i>@_genres @_subgenres</i>
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="8">
            <FluentButton Id="btnSearch" IconStart="@(new _regular.Size20.VideoClip())"
                          Color="var(--colorBrandForeground1)" OnClick="@Search" Disabled="@(string.IsNullOrEmpty(SearchText))"
                          Title="@localizer["SearchInYoutube"]" Appearance="ButtonAppearance.Transparent" />
            <FluentButton Id="btnSearch" IconStart="@(new _regular.Size20.Search())"
                          Color="var(--colorBrandForeground1)" OnClick="@OpenSearchPanel"
                          Disabled="@(string.IsNullOrEmpty(SearchText))" Title="@localizer["SearchInZ3FM"]"
                          Appearance="ButtonAppearance.Transparent" />
            <div id="NowPlaying"
                 style="color:var(--colorBrandBackground);font-size: 12px;@(string.IsNullOrEmpty(SearchText) ? "display: none;" : "")">
            </div>
        </FluentStack>
    </FluentStack>
    <FluentSpacer />
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                 HorizontalAlignment="HorizontalAlignment.Right" style="width: 112px;" Class="player-controls">
        <FluentButton Id="popoverButton" Class="player-button" IconStart="@(new _regular.Size48.Speaker2())"
                      Color="var(--colorBrandForeground1)" OnClick="@(() => _isPopoverVisible = !_isPopoverVisible)"
                      Title="@localizer["Volume"]" />
        <FluentButton Class="player-button"
                      IconStart="@(_isPlaying ? new _regular.Size48.Pause() : new _regular.Size48.Play())"
                      Color="var(--colorBrandForeground1)" OnClick="@Play" Title="@localizer["PlayStop"]" />
    </FluentStack>
</FluentStack>
<FluentPopover AnchorId="popoverButton" @bind-Opened="_isPopoverVisible" Style="width: 90px; height: 260px;">
    <div class="volume-control">
        <input id="volumeSlider" type="range" class="volume-slider" min="0" max="1" step="any" value="@_volume"
               aria-label="@localizer["Volume"]" />
        <div class="volume-graduation">
            <span>100%</span>
            <span>75%</span>
            <span>50%</span>
            <span>25%</span>
            <span>0%</span>
        </div>
    </div>
</FluentPopover>
<audio id="audio" src="@AudioUrl" controls style="display: none;" onerror="@ShowMessage" onstalled="@ShowMessage" />

@code {
    [Parameter]
    public int? StationId { get; set; }
    private HttpClient? httpClient;

    private bool _isPlaying;
    private string? _country;
    private string? _cities;
    private string? _genres;
    private string? _subgenres;
    private string? _searchText = string.Empty;
    private string? SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                StateHasChanged();
            }
        }
    }
    private double _volume = 0.5;
    private bool _isPopoverVisible;
    private Station? Station { get; set; }
    private DotNetObjectReference<Player>? thisRef;
    private HistoryRecordEqualityComparer historyRecordEqualityComparer = new HistoryRecordEqualityComparer();
    string AudioUrl
    {
        get
        {
            if (Station?.Stream.ToLower().Contains(".pcradio.") == true)
            {
                var quality = options.Value.GetQuality();
                if (Station?.Stream.EndsWith("-med") == true)
                {
                    return Station.Stream.Replace("-med", $"-{quality}");
                }
                else
                {
                    return $"{Station?.Stream}-{quality}";
                }
            }

            return Station?.Stream ?? string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        appStateService.CultureChanged += OnCultureChanged;
        httpClient = httpClientFactory.CreateClient("PCRadio.Player.Client");
        await base.OnInitializedAsync();
    }

    private void OnCultureChanged(System.Globalization.CultureInfo culture)
    {
        _ = InvokeAsync(() =>
        {
            System.Globalization.CultureInfo.CurrentCulture = culture;
            System.Globalization.CultureInfo.CurrentUICulture = culture;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var timeout = options?.Value?.TitleDelayMilliseconds ?? 5000;
                if (timeout < 1000)
                {
                    timeout = 5000;
                }

                thisRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("setPageRef", thisRef);
                await JSRuntime.InvokeVoidAsync("initComponent", timeout);
                logger?.LogInformation("Player initialized");
            }
            catch (Exception ex)
            {
                logger?.LogError(ex, "Error initializing player");
            }
        }

        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("initVolumeControl");
                await JSRuntime.InvokeVoidAsync("setVolume", _volume);
            }
            catch (Exception ex)
            {
                logger?.LogError(ex, "Error setting initial volume");
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("playAudio", _isPlaying);
        }
        catch (Exception ex)
        {
            logger?.LogError(ex, "Error controlling audio playback");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (StationId.HasValue && Station?.Id != StationId.Value)
        {
            SearchText = string.Empty;
            Station = await stations.GetStationAsync(StationId.Value);

            if (Station != null)
            {
                _country = Station.Country?.Name ?? string.Empty;
                _cities = string.Join(", ", Station.StationCities?.Select(x => x.City?.Name)
                .Where(x => !string.IsNullOrEmpty(x)) ?? Array.Empty<string>());
                _genres = string.Join(", ", Station.StationGenres?.Select(x => x.Genre?.Name)
                .Where(x => !string.IsNullOrEmpty(x)) ?? Array.Empty<string>());
                _subgenres = string.Join(", ", Station.StationSubGenres?.Select(x => x.SubGenre?.Name)
                .Where(x => !string.IsNullOrEmpty(x)) ?? Array.Empty<string>());
                StateHasChanged();
            }
        }

        await base.OnParametersSetAsync();
    }

    private async Task Play()
    {
        _isPlaying = !_isPlaying;
        try
        {
            await JSRuntime.InvokeVoidAsync("playAudio", _isPlaying);
        }
        catch (Exception ex)
        {
            logger?.LogError(ex, "Error controlling playback");
        }
    }

    private async Task ShowMessage()
    {
        if (Station != null)
        {
            var options = new ToastOptions
            {
                Intent = ToastIntent.Error,
                Title = localizer["Error"]
            };
            options.Parameters["Content"] = new ErrorData
            {
                Message = $"{localizer["StreamNotAvailable"]}: {Station.Name}",
                ActionMessage = localizer["CopyUrl"],
                ActionIcon = new _regular.Size28.Copy(),
                ActionCallback = EventCallback.Factory.Create<ToastResult>(this, async () =>
                {
                    await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", AudioUrl);
                })
            };

            await notificationService.ShowToastAsync<ErrorMessage>(options);

            _isPlaying = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("playAudio", _isPlaying);
            }
            catch (Exception ex)
            {
                logger?.LogError(ex, "Error stopping playback after stream error");
            }
        }
    }

    private async Task ToggleFavorite()
    {
        if (Station != null)
        {
            Station.IsFavorite = !Station.IsFavorite;
            await stations.SetFavoriteAsync(Station.Id, Station.IsFavorite);
            appStateService.FavoriteStation = new FavoriteStation
            {
                StationId = Station.Id,
                IsFavorite = Station.IsFavorite
            };
        }
    }

    private void Search()
    {
        if (!string.IsNullOrWhiteSpace(SearchText) && options?.Value != null)
        {
            try
            {
                var encodedText = Uri.EscapeDataString(SearchText);
                var searchUrl = string.Format(options.Value.TrackSearchUrl, encodedText);
                linkOpeningService.OpenUrl(searchUrl);
            }
            catch (Exception ex)
            {
                logger?.LogError(ex, "Error performing search for: {SearchText}", SearchText);
            }
        }
    }

    private async Task OpenSearchPanel()
    {
        var content = SearchText ?? string.Empty;
        var options = new DialogOptions
        {
            Alignment = DialogAlignment.End,
            Width = "450px"
        };
        options.Header.Title = localizer["SearchInZ3FM"];
        options.Parameters.Add(nameof(SearchListPanel.Content), content);
        await dialogService.ShowDialogAsync<SearchListPanel>(options);
    }

    private async Task EditStationInfo()
    {
        if (Station is not null)
        {
            var options = new DialogOptions
            {
                Alignment = DialogAlignment.End,
                Width = "350px"
            };
            options.Header.Title = localizer["StationInfo"];
            options.Parameters.Add(nameof(StationPanel.Content), Station);
            DialogResult result = await dialogService.ShowDialogAsync<StationPanel>(options);
            if (!result.Cancelled)
            {
                Station = await stations.GetStationAsync(Station.Id);
            }
        }
    }

    [JSInvokable]
    public async Task<string> GetCurrentTrackNameAsync()
    {
        var station = Station;

        if (httpClient == null || options?.Value == null || station == null)
        {
            return string.Empty;
        }

        var result = await metadataService.GetTitleAsync(AudioUrl);
        if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.Title))
        {
            SearchText = result.Title;
            await AddToHistoryAsync(SearchText, station.Name, DateTime.Now);
            return SearchText;
        }
        else
        {
            return string.Empty;
        }
    }

    public async Task AddToHistoryAsync(string searchText, string stationName, DateTime startTime,
        CancellationToken cancellationToken = default)
    {
        var lastTrackName = appStateService?.LastHistoryRecord?.TrackName;
        var lastStartTime = appStateService?.LastHistoryRecord?.StartTime;
        var record = new HistoryRecord
        {
            StartTime = (searchText == lastTrackName) ? lastStartTime ?? startTime : startTime,
            StationName = stationName,
            TrackName = searchText
        };

        if (!historyRecordEqualityComparer.Equals(appStateService?.LastHistoryRecord, record))
        {
            try
            {
                await historyRecords.AddAsync(record, cancellationToken);
                appStateService?.LastHistoryRecord = record;
            }
            catch (Exception ex)
            {
                logger?.LogError(ex, "Error adding history record for: {StationName} - {TrackName}", stationName, searchText);
            }
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        appStateService.CultureChanged -= OnCultureChanged;
        try
        {
            // Clean up JavaScript resources
            await JSRuntime.InvokeVoidAsync("cleanupPlayer");
        }
        catch (Exception ex)
        {
            logger?.LogWarning(ex, "Error cleaning up player resources");
        }

        thisRef?.Dispose();
        GC.SuppressFinalize(this);
    }
}